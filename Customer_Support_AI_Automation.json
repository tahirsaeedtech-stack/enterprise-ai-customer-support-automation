    {
      "parameters": {
        "modelId": {
          "__rl": true,
          "mode": "list",
          "value": "models/gemini-3-flash-preview"
        },
        "messages": {
          "values": [
            {
              "content": "=You are an AI customer support classifier.\n\nClassify this customer message:\n{{ $json.message }}\n\nReturn ONLY valid JSON in this exact format:\n\n{\n  \"category\": \"Billing\",\n  \"priority\": \"High\",\n  \"assigned_queue\": \"Human Review\"\n}\n\nChoose:\ncategory: Billing, Technical, Delivery, Account, or General\npriority: High, Medium, or Low\nassigned_queue: Human Review or Routine\n\nDo not include explanations, markdown, or any text outside the JSON."
            }
          ]
        },
        "builtInTools": {},
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.googleGemini",
      "typeVersion": 1.2,
      "position": [
        -816,
        -160
      ],
      "id": "f41c0292-cb84-4446-a065-6d72ddfbb520",
      "name": "AI Support Ticket Classifier",
      "retryOnFail": true,
      "credentials": {
        "googlePalmApi": {
          "id": "MvgbGjHWqKGJEdlT",
          "name": "Google Gemini(PaLM) Api account"
        }
      },
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\nreturn items.map((item, index) => {\n  const data = item.json;\n\n  let raw =\n    data.content?.parts?.[0]?.text ??\n    data.candidates?.[0]?.content?.parts?.[0]?.text ??\n    data.text ??\n    data.output ??\n    data.response;\n\n  if (typeof raw !== \"string\") {\n    throw new Error(\"AI response text not found for item \" + (index + 1));\n  }\n\n  raw = raw.trim()\n    .replace(/^```(?:json)?\\s*/i, \"\")\n    .replace(/\\s*```$/, \"\");\n\n  let result;\n  try {\n    result = JSON.parse(raw);\n  } catch (error) {\n    throw new Error(\"Invalid AI JSON for item \" + (index + 1) + \": \" + error.message);\n  }\n\n  return {\n    json: {\n      ticket_id: result.ticket_id,\n      category: result.category,\n      priority: result.priority,\n      suggested_response: result.suggested_response,\n      human_review_required: result.human_review_required\n    },\n    pairedItem: index\n  };\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
